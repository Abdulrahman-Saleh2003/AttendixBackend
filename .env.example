# ==============================================================================
# ATTENDIX / BASMATI - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# ملاحظة هامة: هذا الملف نموذج فقط يُرفع إلى GitHub.
# على السيرفر أو محلياً، قم بنسخه وتسميته `.env` واملأ القيم الفعلية.

# ------------------------------------------------------------------------------
# 1. إعدادات دجانغو الأساسية والأمان
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
DEBUG=False
# اكتب * للسماح بكافة النطاقات، أو افصل بينها بفاصلة (مثال: my-domain.com,api.my-domain.com)
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# 2. بيانات حساب السوبر أدمن (المدير الأعلى للمنظومة)
# ------------------------------------------------------------------------------
SUPERADMIN_EMAIL=eng.abdulrahman.saleh2003@gmail.com
SUPERADMIN_PASSWORD=Abd2003117Eng
SUPERADMIN_FULL_NAME=engAbdulrahmanSaleh

# ------------------------------------------------------------------------------
# 3. إعدادات التوكنات JWT للموبايل وتطبيق Flutter
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=jwt-secret-key-attendix-production-2026
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ------------------------------------------------------------------------------
# 4. إعدادات الوصول CORS
# ------------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 5. إعدادات قاعدة البيانات (محلياً أو على الاستضافة السحابية)
# ------------------------------------------------------------------------------
# الخيار الأول (الأسهل للاستضافات مثل Render, Railway, Supabase, Neon):
# ضع رابط قاعدة البيانات الكامل مباشرة:
# DATABASE_URL=postgres://username:password@hostname.region.tech:5432/dbname?sslmode=require
# DB_SSL_REQUIRE=True

# الخيار الثاني (لقاعدة بيانات PostgreSQL مفصلة محلياً أو على VPS):
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=attendix_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# الخيار الثالث (تطوير محلي سريع بـ SQLite):
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=db.sqlite3
